{
  "name": "lowcoder-comp-templates",
  "version": "0.0.8",
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@types/react": "18",
    "@types/react-dom": "18",
    "lowcoder-cli": "^0.0.30",
    "lowcoder-sdk": "^2.7.6",
    "react": "18",
    "react-dom": "18",
    "typescript": "4.8.4",
    "vite": "^4.5.5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "lowcoder": {
    "description": "Reusable layout templates with native Lowcoder InnerGrid drop-zones",
    "comps": {
      "app_shell_layout": {
        "name": "App Shell Layout",
        "icon": "./icons/template-icon.png",
        "description": "Header, sidebar, and content drop-zones for application shells",
        "isContainer": true,
        "layoutInfo": {
          "w": 24,
          "h": 64,
          "delayCollision": true
        }
      },
      "dashboard_layout": {
        "name": "Dashboard Layout",
        "icon": "./icons/template-icon.png",
        "description": "Header, KPI row, and content drop-zones for dashboards",
        "isContainer": true,
        "layoutInfo": {
          "w": 24,
          "h": 68,
          "delayCollision": true
        }
      },
      "chat_layout": {
        "name": "Chat Layout",
        "icon": "./icons/template-icon.png",
        "description": "Sidebar, message thread, and composer drop-zones for chat apps",
        "isContainer": true,
        "layoutInfo": {
          "w": 24,
          "h": 64,
          "delayCollision": true
        }
      }
    }
  },
  "scripts": {
    "start": "vite",
    "build": "lowcoder-cli build",
    "build_publish": "lowcoder-cli build --publish"
  }
}
